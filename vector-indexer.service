[Unit]
Description=Vector Search File Indexer Daemon
After=network.target
Wants=vector-indexer-worker.service

[Service]
Type=simple
WorkingDirectory=/srv/latvian_mcp/servers/vector-indexer-mcp

# Use virtual environment python
ExecStart=/srv/latvian_mcp/servers/vector-indexer-mcp/venv/bin/python -m daemon.watcher

# Restart policy
Restart=always
RestartSec=5

# Environment
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/srv/latvian_mcp/servers/vector-indexer-mcp/.env

# Resource limits
MemoryMax=512M
CPUQuota=25%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/latvian_mcp /srv/latvian_xtts /srv/latvian_learning /home/david/claude-mpm /home/david/.claude/skills

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vector-indexer

[Install]
WantedBy=default.target
