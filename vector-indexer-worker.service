[Unit]
Description=Vector Indexer Worker - Async indexing pipeline
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/srv/latvian_mcp/servers/vector-indexer-mcp
Environment="PATH=/srv/latvian_mcp/servers/vector-indexer-mcp/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/srv/latvian_mcp/servers/vector-indexer-mcp/.env

# Main process
ExecStart=/srv/latvian_mcp/servers/vector-indexer-mcp/venv/bin/python -m daemon.worker

# Restart configuration
Restart=always
RestartSec=10
StartLimitInterval=0

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vector-indexer-worker

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/latvian_mcp/servers/vector-indexer-mcp

# Resource limits
MemoryMax=4G
CPUQuota=200%

[Install]
WantedBy=default.target
