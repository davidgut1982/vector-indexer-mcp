[Unit]
Description=Vector Indexer MCP HTTP/SSE Server
Documentation=https://github.com/modelcontextprotocol/servers
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/latvian_mcp/servers/vector-indexer-mcp
Environment="PATH=/srv/latvian_mcp/servers/vector-indexer-mcp/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="MCP_SSE_PORT=5558"
Environment="MCP_SSE_HOST=0.0.0.0"
EnvironmentFile=/srv/latvian_mcp/servers/vector-indexer-mcp/.env
ExecStart=/srv/latvian_mcp/servers/vector-indexer-mcp/venv/bin/python3 /srv/latvian_mcp/servers/vector-indexer-mcp/sse_server.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vector-indexer-mcp-http

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/latvian_mcp/servers/vector-indexer-mcp

[Install]
WantedBy=default.target
